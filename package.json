{
  "name": "rackmap",
  "private": true,
  "version": "0.5.0",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @inv/api --filter @inv/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @inv/api db:migrate",
    "db:seed": "pnpm --filter @inv/api db:seed",
    "db:studio": "pnpm --filter @inv/api db:studio",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-only"
}
