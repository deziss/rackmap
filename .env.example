# RackMap — Docker Compose settings. Compose reads `.env` in this directory.
# `make up` generates one with fresh secrets; copy this file only if you would
# rather fill the values in yourself:  cp .env.example .env && chmod 600 .env
# A bare-metal or development API reads apps/api/.env instead, not this file.
# Every available setting is documented in docs/CONFIGURATION.md.

NODE_ENV=production
# Host port for the web UI (the API listens on 3001 inside the network).
PORT=8080
# The URL you actually browse. The port must match PORT, or sign-in is rejected
# with 403 "Invalid origin" — the page loads and the password is right, so the
# only symptom is a failed request. localhost, 127.0.0.1, [::1] and 0.0.0.0 are
# accepted interchangeably; any other hostname or LAN IP must be listed in
# TRUSTED_ORIGINS below.
WEB_ORIGIN=http://localhost:8080

# Bundled PostgreSQL. Hex, never base64: it is spliced into a connection URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing, at least 16 characters.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
# At-rest encryption for stored credentials. Keep a copy — lose it and every
# stored credential is permanently unreadable.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=
# First-run admin, empty database only. Production: 12+ chars, not a default.
#   openssl rand -hex 12
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com

# ─── Common overrides — uncomment what you need ──────────────────────────────
# POSTGRES_HOST_PORT=5433                      # the host already uses 5432
# PUBLIC_BASE_URL=https://rackmap.example.com  # cron heartbeats, alert links
# Every other origin the UI is reached at — a LAN IP, a hostname, a domain.
# Comma-separated, scheme and port included. Defaults to WEB_ORIGIN.
# TRUSTED_ORIGINS=http://192.168.1.10:8080,https://rackmap.example.com
# SSH_ENABLED=true                             # browser SSH terminal (admin-only)
# SEED_DEMO_DATA=true                          # demo data; credentials published
# An external PostgreSQL 18, used verbatim — percent-encode the password:
# DOCKER_DATABASE_URL=postgresql://rackmap:pa%2Fss@db.example.com:5432/rackmap
