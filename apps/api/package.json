{
  "name": "@inv/api",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && tsup prisma/seed.ts --format esm --target node22 --out-dir dist --no-clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:import-infra": "tsx prisma/import-infrastructure-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@inv/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "better-auth": "^1.6.22",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "nodemailer": "^9.1.1",
    "p-limit": "^6.2.0",
    "ssh2": "^1.17.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "^1.15.5",
    "prisma": "^6.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  },
  "license": "AGPL-3.0-only"
}
