generator client {
  provider = "prisma-client-js"
}

datasource db {
  // To switch to Postgres: change "sqlite" -> "postgresql", delete migrations/, run `prisma migrate dev --name baseline`
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Better Auth tables ──────────────────────────────────────────────────────
// NOTE: run `npx @better-auth/cli generate` after editing auth.ts to get the
// authoritative schema. The fields below match better-auth v1.x core + admin +
// twoFactor + apiKey plugins. Hand-add `auditLogs` relation after generation.

model User {
  id                     String                  @id
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  // admin plugin
  role                   String?                 @default("viewer")
  banned                 Boolean?                @default(false)
  banReason              String?
  banExpires             DateTime?
  // twoFactor plugin
  twoFactorEnabled       Boolean?                @default(false)
  sessions               Session[]
  accounts               Account[]
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  savedViews             SavedView[]
  accessRequests         AccessRequest[]         @relation("Requester")
  resolvedRequests       AccessRequest[]         @relation("Resolver")
  notificationPreference NotificationPreference?
  orders                 Order[]

  @@map("user")
}

model Session {
  id             String   @id
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String @id
  userId      String @unique
  secret      String
  backupCodes String

  /// Set false while a factor is being enrolled but not yet confirmed.
  /// Declared by the better-auth twoFactor plugin; it defaults this to true.
  verified                Boolean?  @default(true)
  /// Consecutive failed TOTP verifications. better-auth 1.6.21+ enables an
  /// account lockout BY DEFAULT (10 attempts, 15 minutes) and writes these two
  /// columns on every verification attempt — without them, verifying a second
  /// factor fails at runtime.
  failedVerificationCount Int?      @default(0)
  /// Set when the lockout trips; verification is refused until it passes.
  lockedUntil             DateTime?

  @@map("twoFactor")
}

model ApiKey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String    @unique
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillAt            DateTime?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(false)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  expiresAt           DateTime?
  /// Optional role ceiling for this key. When set, requests authenticated with
  /// it are capped at this role even if the owning user is more privileged —
  /// so an automation key can be read-only. Null means "inherit the owner's role".
  scopeRole           String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@map("apiKey")
}

// ─── Lookup tables ───────────────────────────────────────────────────────────
model CloudProvider {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

model GpuType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

model AllocatedTo {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

model ServerType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

model NetworkType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  servers   Server[]
}

// ─── Tags ────────────────────────────────────────────────────────────────────
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  color    String?
  servers  ServerTag[]
  services ServiceTag[]
}

model ServerTag {
  serverId Int
  tagId    Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@index([tagId])
}

// ─── Inventory ───────────────────────────────────────────────────────────────
model Server {
  id              Int             @id @default(autoincrement())
  hostname        String
  ip              String
  username        String
  /// AES-256-GCM blob "v1.<iv>.<tag>.<ct>". NEVER sent to client.
  passwordEnc     String?
  /// Per-server SSH port (varies — from Excel SSH column). Probe uses this.
  sshPort         Int             @default(22)
  cpu             String?
  ram             String?
  gpuCount        Int?
  remark          String?
  domain          String?
  environment     String?         @default("on-premise")
  cloudProviderId Int?
  cloudProvider   CloudProvider?  @relation(fields: [cloudProviderId], references: [id], onDelete: Restrict)
  gpuTypeId       Int?
  gpuType         GpuType?        @relation(fields: [gpuTypeId], references: [id], onDelete: Restrict)
  allocatedToId   Int?
  allocatedTo     AllocatedTo?    @relation(fields: [allocatedToId], references: [id], onDelete: Restrict)
  locationId      Int?
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  serverTypeId    Int?
  serverType      ServerType?     @relation(fields: [serverTypeId], references: [id], onDelete: Restrict)
  networkTypeId   Int?
  networkType     NetworkType?    @relation(fields: [networkTypeId], references: [id], onDelete: Restrict)
  tags            ServerTag[]
  /// Denormalized latest probe result (updated by scheduler; NOT audited)
  lastStatus      String          @default("unknown")
  lastCheckedAt   DateTime?
  lastLatencyMs   Int?
  /// Consecutive down count — triggers notification at threshold
  downStreak      Int             @default(0)
  notifiedDown    Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updatedByEmail  String?
  osType          String?
  disk            String?
  isPrivateIp     Boolean         @default(false)
  purpose         String?
  createdBy       String?
  // ── Backup Automation & Policies ───────────────────────────────────────────
  backupScript      String?  @map("backup_script")
  backupDestination String?  @map("backup_destination")
  backupSchedule    String?  @map("backup_schedule")
  backupDurability  String?  @map("backup_durability")
  backupDataType    String?  @map("backup_data_type")


  statusChecks    StatusCheck[]
  accessRequests  AccessRequest[]
  sslStatuses     SslStatus[]

  @@index([cloudProviderId])
  @@index([gpuTypeId])
  @@index([allocatedToId])
  @@index([locationId])
  @@index([serverTypeId])
  @@index([networkTypeId])
  @@index([deletedAt])
  @@index([hostname])
  @@index([ip])
}

model StatusCheck {
  id        Int      @id @default(autoincrement())
  serverId  Int
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status    String
  latencyMs Int?
  /// Whitelisted error code only — never raw socket data
  errorCode String?
  checkedAt DateTime @default(now())

  @@index([serverId, checkedAt])
}

// ─── Audit (append-only) ─────────────────────────────────────────────────────
model AuditLog {
  id         Int      @id @default(autoincrement())
  /// 'data' | 'auth'
  category   String
  action     String
  entity     String?
  entityId   String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot — survives user deletion
  actorEmail String?
  /// JSON text (passwordEnc always redacted before write)
  beforeJson String?
  afterJson  String?
  /// Changed keys only: {"field":{"from":x,"to":y}}
  diffJson   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([category, createdAt])
}

// ─── Access Requests (viewer approval for SSH / password reveal) ─────────────
model AccessRequest {
  id          Int       @id @default(autoincrement())
  requesterId String
  requester   User      @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  serverId    Int?
  server      Server?   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serviceId   Int?
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// "ssh" | "password_reveal" | "service_password_reveal"
  type        String
  /// "pending" | "approved" | "rejected"
  status      String    @default("pending")
  note        String?
  adminNote   String?
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  resolver    User?     @relation("Resolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  /// Approval valid until (null = indefinite)
  expiresAt   DateTime?

  @@index([requesterId])
  @@index([serverId])
  @@index([status])
}

// ─── Saved views ─────────────────────────────────────────────────────────────
model SavedView {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Serialized servers-table filter + column-visibility state
  paramsJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ─── Notification Preferences ────────────────────────────────────────────────
model NotificationPreference {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  newServerAdded  Boolean @default(false)
  serverUpDown    Boolean @default(false)
  gpuCountChanged Boolean @default(false)
  diskUnmounted   Boolean @default(false)
  diskFull        Boolean @default(false)
  ramFull         Boolean @default(false)
  highCpu         Boolean @default(false)
  userRegistered  Boolean @default(false) // Admin only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Services ────────────────────────────────────────────────────────────────
model Service {
  id           Int     @id @default(autoincrement())
  serviceName  String  @map("service_name")
  serviceType  String? @map("service_type")
  serverIp     String? @map("server_ip")
  port         String?
  domain       String?
  username     String?
  passwordEnc  String? @map("password")
  documentLink String? @map("document_link")
  project      String?
  version      String?
  environment  String? @default("on-premise")
  dbName       String? @map("db_name")
  managedBy    String? @map("managed_by")
  remark       String?
  nodePort     Int?    @map("node_port")
  role         String?
  accountId    String? @map("account_id")
  region       String?
  authTokenEnc String? @map("auth_token")
  healthUrl    String? @map("health_url")
  status       String? @default("working")

  lastStatus    String    @default("unknown") @map("last_status")
  lastCheckedAt DateTime? @map("last_checked_at")
  lastLatencyMs Int?      @map("last_latency_ms")
  downStreak    Int       @default(0) @map("down_streak")
  notifiedDown  Boolean   @default(false) @map("notified_down")

  tags ServiceTag[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sslStatuses    SslStatus[]
  accessRequests AccessRequest[]

  @@map("services")
}

model ServiceTag {
  serviceId Int
  tagId     Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
  @@index([tagId])
}

// ─── SSL Status ──────────────────────────────────────────────────────────────
model SslStatus {
  id      Int     @id @default(autoincrement())
  domain  String  @unique
  team    String?
  project String?

  serverId  Int?
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  issuer        String?
  validFrom     DateTime?
  validTo       DateTime?
  daysRemaining Int?

  status        String    @default("unknown")
  lastError     String?
  lastScannedAt DateTime?

  isManual Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Vault (Envelope Encryption for Server Passwords) ────────────────────────
model SystemVault {
  id           Int      @id @default(1)
  salt         String
  verifier     String
  encryptedDek String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("system_vault")
}

// ─── Licencia Subscription & Feature Gates ──────────────────────────────────
model SystemLicense {
  id           Int       @id @default(1)
  key          String?
  leaseToken   String?
  tier         String    @default("free") // "free" | "pro" | "enterprise"
  featuresJson String    @default("{}")
  maxServers   Int       @default(10)     // -1 for unlimited
  expiresAt    DateTime?
  cachedAt     DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("system_license")
}

// ─── Orders & Subscriptions (Licencia Checkout) ──────────────────────────────
model Order {
  id             String    @id @default(uuid())
  sessionId      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String    // "free" | "pro" | "enterprise"
  billingCycle   String    // "monthly" | "annual"
  amount         Float
  currency       String    @default("USD")
  customerName   String
  customerEmail  String
  company        String?
  status         String    @default("pending") // "pending" | "paid" | "failed"
  paymentGateway String?   // "razorpay" | "card" | "free"
  paymentRef     String?
  licenseKey     String?
  invoiceNumber  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("orders")
}

// ─── SSH host keys (trust-on-first-use) ──────────────────────────────────────
/// One row per SSH *endpoint* — the (host, port) pair the client actually dialled
/// — NOT per Server row.
///
/// The trust anchor deliberately is not `serverId`: a Server's `ip` is editable by
/// any user with server.update, so keying trust on the server row would let an
/// edited `ip` silently inherit the previous host's pinned key and connect (with
/// the decrypted password, over the keyboard-interactive fallback) to an attacker
/// endpoint with no mismatch raised. `host` is the value AFTER `resolveTargetHost`,
/// lower-cased, so what we pin is exactly what we connected to.
///
/// `serverId` is a best-effort, non-relational back-reference for operator review
/// only. There is intentionally no foreign key: deleting and recreating a server
/// row must NOT discard the pinned key for an endpoint that is still reachable.
model SshHostKey {
  id          Int      @id @default(autoincrement())
  /// Address actually connected to (post-`resolveTargetHost`), lower-cased.
  host        String
  port        Int      @default(22)
  /// Public key algorithm read from the key blob, e.g. "ssh-ed25519", "ssh-rsa".
  keyType     String
  /// OpenSSH-style fingerprint: "SHA256:" + base64(sha256(blob)), padding stripped.
  /// Matches `ssh-keygen -lf` output, so operators can diff it against the host.
  fingerprint String
  /// Base64 of the raw public key blob exactly as the server presented it.
  publicKey   String
  /// When this endpoint's key was first pinned (TOFU moment).
  firstSeenAt DateTime @default(now())
  /// Last time this exact key was presented and matched. Deliberately NOT bumped
  /// on a mismatch — a mismatch leaves the pinned row completely untouched.
  lastSeenAt  DateTime @default(now())
  /// Best-effort back-reference (no FK — see model note above).
  serverId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([host, port])
  @@index([serverId])
  @@index([fingerprint])
  @@map("ssh_host_key")
}

// ─── Background job leases (multi-replica scheduler) ─────────────────────────
/// One row per background job. A replica may run that job only while it holds the
/// row's lease: `holder` equal to its own instance id and `expiresAt` in the future.
/// Without this, the only thing keeping two API replicas from double-probing every
/// server and firing every notification twice was `instances: 1` in the PM2 config.
///
/// Acquisition is deliberately a single conditional statement rather than a read
/// followed by a write:
///   * taking an expired lease is `UPDATE ... WHERE name = ? AND expires_at <= now`,
///     so the database evaluates the expiry under the row's write lock — the first
///     replica pushes `expires_at` into the future and the second's predicate then
///     matches nothing;
///   * the very first acquisition (no row yet) races on the `name` unique index,
///     where exactly one INSERT can win and the loser sees a unique violation.
///
/// Rows are rewritten in place and never deleted, so the table holds exactly one row
/// per job name. Every query is keyed by `name`, which the unique index covers;
/// there is deliberately no index on `expiresAt` because nothing ever filters on it
/// alone.
model SchedulerLock {
  id          Int      @id @default(autoincrement())
  /// Job identity, e.g. "scheduler:tick", "alert:metrics", "backup:nightly".
  name        String   @unique
  /// Instance id of the process holding — or last to hold — the lease: host:pid:rand.
  holder      String
  /// When the current holder took the lease.
  acquiredAt  DateTime @default(now())
  /// Last renewal. Renewed on a timer while the job runs, so a long sweep does not
  /// lose the lease mid-run; it stops the moment the holder's process dies.
  heartbeatAt DateTime @default(now())
  /// Lease deadline. Any replica may take the lease once this is in the past, which
  /// is what makes a holder killed mid-job recoverable with no operator action.
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scheduler_lock")
}
