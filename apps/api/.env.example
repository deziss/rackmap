# RackMap API — bare-metal and development settings.
#
#   cp apps/api/.env.example apps/api/.env
#
# The API process and the Prisma CLI read this file from apps/api/. Docker
# Compose does not: it reads the root .env. Full reference in
# docs/CONFIGURATION.md.

NODE_ENV=development
# The Vite dev server proxies /api and /health to this port.
PORT=3001
# PostgreSQL 18. Percent-encode any special character in the password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/server_inventory?schema=public

BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

#   openssl rand -hex 32
BETTER_AUTH_SECRET=
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Development only — the seed refuses this password when NODE_ENV=production.
SEED_ADMIN_PASSWORD=Admin123!
